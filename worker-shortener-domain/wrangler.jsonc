{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worker-shortener-domain",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "routes": [{ "pattern": "jli.li/*", "zone_name": "jli.li" }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<hyperdrive-id-here>",
      "localConnectionString": "postgres://user:0000@localhost:1234/test",
    },
  ],
}
