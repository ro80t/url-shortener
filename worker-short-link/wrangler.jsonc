{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "short-link",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./app/server.ts",
  "routes": [{ "pattern": "short-link.ro80t.com/*", "zone_name": "ro80t.com" }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a025f81ae553430181e81076e73f31b5",
      "localConnectionString": "postgres://user:0000@localhost:1234/test",
    },
  ],
}
